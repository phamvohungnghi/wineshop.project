<%-- any content can be specified here e.g.: --%>
<%@ page pageEncoding="UTF-8" %>
<%@page import="java.util.List"%>
<%@page import="models.Products"%>

<%
    List<Products> productList = (List<Products>) request.getAttribute("productList");
    if (productList == null) {
        productList = new java.util.ArrayList<>();
    }
%>

<style>
    .content-container {
        display: flex;
        gap: 20px;
        padding: 20px 30px;
        font-family: Arial, sans-serif;
    }

    .filter-box {
        width: 270px;
        background: #f8f4ee;
        border: 1px solid #e5d7c3;
        border-radius: 14px;
        padding: 20px;
        height: fit-content;
    }

    .filter-box h2 {
        text-align: center;
        color: #7b1e3a;
        margin-bottom: 18px;
        font-size: 24px;
    }

    .filter-title {
        font-weight: bold;
        color: #8b5e3c;
        margin-top: 18px;
        margin-bottom: 10px;
        font-size: 17px;
    }

    .filter-box label {
        display: block;
        margin: 10px 0;
        font-size: 16px;
        color: #5c4033;
    }

    .filter-box button {
        margin-top: 18px;
        padding: 10px 18px;
        border: none;
        border-radius: 8px;
        background: #7b1e3a;
        color: white;
        cursor: pointer;
        font-weight: bold;
        width: 100%;
    }

    .product-area {
        flex: 1;
    }

    .product-title {
        text-align: center;
        font-size: 30px;
        color: #8b5e3c;
        margin-bottom: 20px;
        font-weight: bold;
    }

    .product-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
        gap: 25px;
    }

    .product-card {
        background: white;
        border: 1px solid #e7dccc;
        border-radius: 14px;
        padding: 18px;
        text-align: center;
        box-shadow: 0 2px 6px rgba(0,0,0,0.05);

        display: flex;
        flex-direction: column;
        min-height: 560px;
    }
    .product-info {
        flex: 1;
        display: flex;
        flex-direction: column;
    }

    .product-card form {
        margin-top: auto;
    }

    .product-card img {
        width: 180px;
        height: 240px;
        object-fit: contain;
        margin-bottom: 15px;
    }

    .product-name {
        font-size: 20px;
        font-weight: bold;
        color: #3a2a20;
        margin-bottom: 8px;
        min-height: 52px;
    }

    .product-category {
        font-size: 16px;
        color: #6d4c41;
        margin-bottom: 8px;
    }

    .product-price {
        font-size: 18px;
        color: #c76b29;
        font-weight: bold;
        margin-bottom: 8px;
    }

    .old-price {
        display: block;
        color: gray;
        text-decoration: line-through;
        margin-bottom: 5px;
        font-size: 15px;
    }

    .add-cart-btn {
        margin-top: 10px;
        padding: 10px 16px;
        border: none;
        border-radius: 8px;
        background: #2e1f1a;
        color: white;
        cursor: pointer;
        font-weight: bold;
    }
    .product-card {
        min-height: 560px;
    }

    .add-cart-btn:hover {
        background: #4a2f28;
    }


    .return-btn {
        display: inline-block;
        margin-bottom: 18px;
        padding: 10px 16px;
        background: #9c6b30;
        color: white;
        text-decoration: none;
        border-radius: 8px;
        font-weight: bold;
    }

    .return-btn:hover {
        background: #7d5524;
    }
</style>

<div class="content-container">

    <div class="filter-box">
        <h2>Filter</h2>

        <form action="loc_sanpham" method="get">

            <div class="filter-title">Price Range</div>
            <label><input type="radio" name="price" value="under1m"> Under 1 million</label>
            <label><input type="radio" name="price" value="1mto5m"> 1 million - 5 million</label>
            <label><input type="radio" name="price" value="5mto15m"> 5 million - 15 million</label>
            <label><input type="radio" name="price" value="above15m"> Above 15 million</label>

            <div class="filter-title">Discount</div>
            <label><input type="radio" name="discount" value="all" checked> All products</label>
            <label><input type="radio" name="discount" value="discounted"> Discounted</label>
            <label><input type="radio" name="discount" value="notDiscounted"> Non-discounted</label>

            <div class="filter-title">Sort by Price</div>
            <label><input type="radio" name="sort" value="asc"> Low to High</label>
            <label><input type="radio" name="sort" value="desc"> High to Low</label>

            <button type="submit">Apply Filter</button>
        </form>
    </div>

    <div class="product-area">
        <div class="product-title">Featured Wines</div>

        <a class="return-btn" href="san_pham">Return All Products</a>

        <div class="product-grid">
            <%
                for (Products p : productList) {
            %>
            <div class="product-card">
                <a href="da_xem?id=<%= p.getId()%>">
                    <img src="images/<%= p.getImage()%>" alt="<%= p.getProductName()%>">
                </a>
                <a href="da_xem?id=<%= p.getId()%>">
                    <div class="product-name"><%= p.getProductName()%></div>
                </a>             
                <div class="product-category">Category: <%= p.getCategory()%></div>
                <%
                    if (p.getDiscountPrice().compareTo(p.getPrice()) < 0) {
                %>
                <span class="old-price"><%= p.getPrice().intValue()%> VND</span>
                <div class="product-price"><%= p.getDiscountPrice().intValue()%> VND</div>
                <%
                } else {
                %>
                <div class="product-price"><%= p.getPrice().intValue()%> VND</div>
                <%
                    }
                %>

                <form action="CartController" method="post">
                    <input type="hidden" name="id" value="<%= p.getId()%>">
                    <button class="add-cart-btn" type="submit">Add to cart</button>
                </form>
            </div>
            <%
                }
            %>
        </div>
    </div>

</div>
